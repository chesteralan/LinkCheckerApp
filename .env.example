# No environment variables are required for local development.
# Tauri-specific vars use TAURI_ prefix.
# Vite vars use VITE_ prefix.

# Optional: absolute path to a Chromium-based browser (Chrome, Chromium, Edge,
# Brave) used by accessibility scans. Overrides automatic browser detection.
# Read by src-tauri/src/a11y_browser.rs.
# A11Y_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: URL scanned by the ignored a11y browser smoke test
# (cargo test --manifest-path src-tauri/Cargo.toml -- --ignored).
# Defaults to https://example.com.
# A11Y_TEST_URL=https://example.com
